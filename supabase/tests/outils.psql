-- =====================================================================
-- Outils communs des tests pgTAP (inclus par chaque fichier : \ir outils.psql)
-- =====================================================================
-- Chaque fichier de test tourne dans UNE transaction annulée à la fin : le
-- jeu d'essai ci-dessous n'existe que le temps du fichier.
--
-- Changer d'utilisateur :
--   reset role; select tests.connecte('proprio_a');   -- membre, client…
--   reset role; select tests.anonyme();               -- visiteur de la vitrine
--   reset role; select tests.service();               -- clé service_role
-- `reset role` revient à `postgres`, propriétaire des tables, qui contourne la
-- RLS (comme une fonction SECURITY DEFINER, ou la console côté serveur).
--
-- Jeu d'essai :
--   boutique A « essai-a » (active), B « essai-b » (active),
--   C « essai-suspendue » (suspendue, avec un produit publié) ;
--   (identifiants distincts de ceux du jeu de démo supabase/seed.sql, que la
--   CI charge aussi) ;
--   équipe de A : proprio_a, lecture_a, prepa_a, confirm_a ; de B : proprio_b ;
--   multi : admin dans A, lecture dans B ; inconnu : connecté, sans rôle ;
--   client_a : client de A ; client_ab : client de A et de B ;
--   un invité (sans compte) dans A.
-- =====================================================================

set local client_min_messages = warning;
create extension if not exists pgtap with schema extensions;
set local search_path = public, extensions;

create schema tests;
grant usage on schema tests to anon, authenticated, service_role;

create table tests.ids (nom text primary key, id uuid not null default gen_random_uuid());
grant select on tests.ids to anon, authenticated, service_role;

-- Résultats relevés sous un rôle, comparés ensuite sous postgres.
create table tests.vus (qui text, nom_table text, n bigint);
grant insert, select on tests.vus to anon, authenticated, service_role;

create function tests.id(p_nom text) returns uuid
language sql stable as $$ select id from tests.ids where nom = p_nom $$;

create function tests.nouvel_id(p_nom text) returns uuid
language sql as $$ insert into tests.ids (nom) values (p_nom) returning id $$;

create function tests.cree_utilisateur(p_nom text) returns uuid
language sql as $$
  insert into auth.users (id, email, raw_user_meta_data)
  values (tests.nouvel_id(p_nom), p_nom || '@tests.skanecom.local', '{}'::jsonb)
  returning id
$$;

create function tests.connecte(p_nom text) returns void
language plpgsql as $$
begin
  perform set_config('role', 'authenticated', true);
  perform set_config('request.jwt.claims',
    json_build_object('sub', tests.id(p_nom), 'role', 'authenticated')::text, true);
end;
$$;

create function tests.anonyme() returns void
language plpgsql as $$
begin
  perform set_config('role', 'anon', true);
  perform set_config('request.jwt.claims', '{"role": "anon"}', true);
end;
$$;

create function tests.service() returns void
language plpgsql as $$
begin
  perform set_config('role', 'service_role', true);
  perform set_config('request.jwt.claims', '{"role": "service_role"}', true);
end;
$$;

-- Nombre de lignes d'une boutique visibles par le rôle courant, pour CHAQUE
-- table de public qui porte boutique_id : une table ajoutée demain est
-- couverte sans toucher aux tests.
create function tests.lignes_visibles(p_boutique_id uuid)
returns table (nom_table text, n bigint)
language plpgsql as $$
declare
  t record;
begin
  for t in
    select c.relname
    from pg_class c
    join pg_namespace s on s.oid = c.relnamespace
    join pg_attribute a on a.attrelid = c.oid and a.attname = 'boutique_id' and not a.attisdropped
    where s.nspname = 'public' and c.relkind in ('r', 'p')
    order by c.relname
  loop
    nom_table := t.relname;
    execute format('select count(*) from public.%I where boutique_id = $1', t.relname)
      into n using p_boutique_id;
    return next;
  end loop;
end;
$$;

grant execute on all functions in schema tests to anon, authenticated, service_role;


-- ---------------------------------------------------------------------
-- Jeu d'essai (écrit par postgres, hors RLS)
-- ---------------------------------------------------------------------
insert into plateforme.boutiques (id, slug, nom, statut) values
  (tests.nouvel_id('A'), 'essai-a',         'Essai A',         'active'),
  (tests.nouvel_id('B'), 'essai-b',         'Essai B',         'active'),
  (tests.nouvel_id('C'), 'essai-suspendue', 'Essai suspendue', 'suspendue');

insert into plateforme.domaines (hote, boutique_id, type, principal) values
  ('essai-a.test',           tests.id('A'), 'personnalise', true),
  ('www.essai-a.test',       tests.id('A'), 'personnalise', false),
  ('essai-b.test',           tests.id('B'), 'personnalise', true);

do $$
begin
  perform tests.cree_utilisateur(u) from unnest(array[
    'proprio_a', 'lecture_a', 'prepa_a', 'confirm_a', 'proprio_b', 'multi',
    'inconnu', 'client_a', 'client_ab', 'admin_plateforme']) u;
end
$$;

insert into plateforme.membres (boutique_id, user_id, role) values
  (tests.id('A'), tests.id('proprio_a'), 'proprietaire'),
  (tests.id('A'), tests.id('lecture_a'), 'lecture'),
  (tests.id('A'), tests.id('prepa_a'),   'preparateur'),
  (tests.id('A'), tests.id('confirm_a'), 'confirmateur'),
  (tests.id('B'), tests.id('proprio_b'), 'proprietaire'),
  (tests.id('A'), tests.id('multi'),     'admin'),
  (tests.id('B'), tests.id('multi'),     'lecture');

insert into plateforme.administrateurs (user_id, role) values (tests.id('admin_plateforme'), 'super_admin');

