# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Caches Python des outils de marque/photos (générés, jamais versionnés)
__pycache__/

# graphify (13/08) — regénéré, jamais versionné
graphify-out/
.graphify_*.json
/dist/
.vinext/
.cloudflare/

# Secrets locaux des Workers (clé service_role de développement)
.dev.vars*
