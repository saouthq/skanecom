    "cf": "^1.0.0-beta.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright-core": "1.56.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.0"
